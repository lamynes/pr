          "_name": "header02",
          "_sourceTheme": "pizzam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header02\" group=\"Header\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Text</header>\n        <input type=\"color\" title=\"Colored\" value=\"#e43f3f\" name=\"coloredTextColor\">\n        <header>Content</header>\n        <select title=\"Align\" name=\"alignText\">\n            <option value=\"start\">Left</option>\n            <option value=\"center\">Center</option>\n            <option value=\"end\" selected>Right</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/copilot-20250725-162022.png-1-1536x1024.png\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#414142\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"px-0 pb-md-3 px-sm-3\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row mb-5 mx-0 mx-sm-5\" mbr-if=\"showTitle\">\n            <div class=\"col-12 px-sm-3\">\n                <h1 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-section-title\" data-app-placeholder=\"Type Text\">FRESH SEAFOOD</h1>\n            </div>\n        </div>\n        <div class=\"row justify-content-{{alignText}} mx-0 mx-sm-5\">\n            <div class=\"mb-5 mb-md-0 col-12 col-md-6 px-sm-3\">\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubitle\" data-app-placeholder=\"Type Text\">COMe Enjoy OUR&nbsp;<span class=\"colored-text\">RESTAURANT/Marina</span>&nbsp;ON THE MOUTH OF FOWL RIVER</h2>\n                <p mbr-if=\"showText\" class=\"mbr-text mbr-fonts-style m-0 pe-2\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" data-app-placeholder=\"Type Text\">We pride ourselves on generous portions, friendly service, and a welcoming atmosphere — including pet-friendly outdoor seating. With weekly events, a full bar, and signature Alabama-style seafood platters, there’s always a reason to reel in good times at Pelican Reef.</p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sMdr6Q6VFC",
          "_anchor": "header02-h",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-media": {
              "position": "relative",
              "img": {
                "max-height": "500px",
                "width": "100%",
                "object-fit": "cover"
              }
            },
            "a": {
              "&:hover": {
                "background-image": "none !important"
              }
            },
            ".triang-play-btn": {
              "border-left-color": "@playColor"
            },
            ".circle-play-btn": {
              "background": "@circleColor"
            },
            ".mbr-media span": {
              "font-size": "4rem",
              "transition": "all 0.2s"
            },
            ".modalWindow": {
              "position": "fixed",
              "z-index": "5000",
              "left": "0",
              "top": "0",
              "background-color": "rgba(61, 61, 61, 0.65)",
              "width": "100%",
              "height": "100%",
              ".modalWindow-container": {
                "display": "table-cell",
                "vertical-align": "middle"
              },
              ".modalWindow-video": {
                "height": "calc(80vw / 1.778)",
                "width": "80vw",
                "margin": "0 auto"
              }
            },
            ".close": {
              "position": "fixed",
              "opacity": "0.5",
              "font-size": "22px",
              "font-weight": "300",
              "width": "60px",
              "height": "60px",
              "border-radius": "50%",
              "color": "#fff",
              "top": "2.5rem",
              "right": "2.5rem",
              "border": "2px solid #fff",
              "text-shadow": "none",
              "z-index": "5",
              "transition": "opacity 0.3s ease",
              "align-items": "center",
              "justify-content": "center",
              "display": "flex",
              "&:hover": {
                "opacity": "1",
                "background": "#000",
                "color": "#fff"
              }
            },
            ".mbr-text": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".colored-text": {
              "color": "@coloredTextColor !important"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            }
          },
          "_name": "video02",
          "_sourceTheme": "pizzam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"video02\" group=\"Image & Video\" plugins=\"PlayerVimeo\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" name=\"textWidth\" title=\"Video\" min=\"4\" max=\"12\" step=\"1\" value=\"12\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Text</header>\n        <input type=\"color\" title=\"Colored\" value=\"#e43f3f\" name=\"coloredTextColor\">\n        <header>Video</header>\n        <input type=\"color\" title=\"Circle\" name=\"circleColor\" value=\"#414142\">\n        <input type=\"color\" title=\"Play\" name=\"playColor\" value=\"#eeeeee\">\n        <input type=\"text\" title=\"Link\" name=\"modalVideo\" value>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input title=\"Image\" type=\"image\" value=\"@PROJECT_PATH@/assets/images/copilot-20250728-132212.png-1536x1024.png\">\n            <input title=\"Color\" type=\"color\" value=\"#101010\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#414142\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"px-0 px-sm-3\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row mx-0 mx-sm-5\">\n            <div mbr-if=\"showTitle\" class=\"col-12 mb-5 px-sm-3\">\n                <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" data-app-placeholder=\"Type Text\">\n                    <i class=\"colored-text\">Always</i> <i>fresh and tasty\n                </i></h3>\n            </div>\n            <div mbr-if=\"showText\" class=\"col-12 px-sm-3 mb-4\">\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-app-placeholder=\"Type Text\">\n                    Ac placerat vestibulum lectus mauris ultrices.\n                    <a class=\"watch-the-video\" href=\"#\">Watch video</a>\n                </p>\n            </div>\n        </div>\n        <div class=\"row mx-0 mx-sm-5 justify-content-center\">\n            <div class=\"col-12 col-lg-{{textWidth}} px-0 px-sm-3\">\n                <div class=\"box\">\n                    <div class=\"mbr-media show-modal align-center\" data-modal=\".modalWindow\">\n                        <img src=\"@PROJECT_PATH@/assets/images/copilot-20250725-150850.png-1536x1024.png\" alt=\"Pelican Reef\">\n                        <a href=\"#\">\n                            <div class=\"wrap-play-btn\">\n                                <div class=\"circle-play-btn\">\n                                    <div class=\"triang-play-btn\"></div>\n                                </div>\n                            </div>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\" data-bs-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbr-iconfont mobi-mbri-close mobi-mbri closeModal\"></span>\n                        <span class=\"sr-only visually-hidden\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uRZBZAKtL2",
          "_anchor": "video02-3",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".mbr-section-title.col-title": {
              "color": "#a68462"
            },
            ".colored-text": {
              "color": "@coloredTextColor !important"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".mbr-section-title.main-title": {
              "color": "#000000",
              "text-align": "left"
            },
            ".mbr-text.main-text": {
              "color": "#000000"
            }
          },
          "_name": "list02",
          "_sourceTheme": "pizzam5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list02\" group=\"List\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Text</header>\n        <input type=\"color\" title=\"Colored\" value=\"#e43f3f\" name=\"coloredTextColor\">\n        <header>Column</header>\n        <input type=\"range\" title=\"Amount\" name=\"colCount\" min=\"0\" max=\"6\" value=\"0\" step=\"1\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showColTitle\" condition=\"colCount > 0\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showColText\" condition=\"colCount > 0\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/copilot-20250728-132212.png-1536x1024.png\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"px-0 px-sm-3\">\n        <div mbr-if=\"showTitle\" class=\"row mx-0 mx-sm-5\">\n            <div class=\"col-12 mb-3 mb-sm-5 px-sm-3\">\n                <h3 class=\"mbr-section-title mbr-fonts-style main-title\" data-app-selector=\".mbr-section-title.main-title\" mbr-theme-style=\"display-5\" data-app-placeholder=\"Type Text\">\n                    About <font color=\"#e43f3f\" style>PELICAN REEF</font></h3>\n            </div>\n        </div>\n        <div class=\"row mx-0 mx-sm-5\">\n            <div class=\"col-12 col-lg-6 px-sm-3\">\n                <div mbr-if=\"showText\" class=\"row mb-3 mb-sm-5\">\n                    <div class=\"col-12\">\n                        <p class=\"mbr-text mbr-fonts-style main-text\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text.main-text\" data-app-placeholder=\"Type Text\">Pelican Reef in Theodore, Alabama is a laid-back seafood spot with a marina view that locals love and visitors remember. Nestled along Fowl River at <a href=\"https://share.google/ZOUHNIHuzcQzKcXqZ\" class=\"text-primary\" target=\"_blank\"><b><i>11799 Dauphin Island Parkway</i></b></a>, it’s just a short drive from Mobile or Dauphin Island — and it feels like a hidden gem once you arrive.\n<br>\n<br>Scenic waterfront dining: You can sit inside or out and enjoy peaceful views of the river and boats drifting by.<br>\n<br><b>Hours:</b> Open Wednesday to Sunday, typically 11 AM to 9 PM (closes at 8 PM on Sundays).\n<br><b><br>Phone:</b> <a href=\"tel:(251) 973-2670\" class=\"text-primary\">(251) 973-2670</a>\n<br><b><br>Atmosphere:</b> Family-friendly, pet-welcoming on the deck, and known for generous portions and friendly service.\n<br>\n<br>If you’re ever cruising down Dauphin Island Parkway and craving seafood with a view, Pelican Reef is worth the stop. Want help planning a visit or checking out the full menu? I’ve got you covered.</p>\n                    </div>\n                </div>\n                <div mbr-if=\"colCount > 0\" class=\"row\">\n                    <div class=\"col-12 col-sm-6 mb-2 mb-sm-4\">\n                        <h5 mbr-if=\"showColTitle\" class=\"mbr-section-title col-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\" data-app-placeholder=\"Type Text\">\n                            <i> 01 </i>\n                        </h5>\n                        <p mbr-if=\"showColText\" class=\"mbr-text col-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text.col-text\" data-app-placeholder=\"Type Text\">\n                            Vulputate eu scelerisque felis imperdiet proin\n                        </p>\n                    </div>\n                    <div mbr-if=\"colCount > 1\" class=\"col-12 col-sm-6 mb-2 mb-sm-4\">\n                        <h5 mbr-if=\"showColTitle\" class=\" mbr-section-title col-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\" data-app-placeholder=\"Type Text\">\n                            <i> 02 </i>\n                        </h5>\n                        <p mbr-if=\"showColText\" class=\"mbr-text col-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text.col-text\" data-app-placeholder=\"Type Text\">\n                            Porta nibh venenatis cras sed felis eget velit\n                        </p>\n                    </div>\n                    <div mbr-if=\"colCount > 2\" class=\"col-12 col-sm-6 mb-2 mb-sm-4\">\n                        <h5 mbr-if=\"showColTitle\" class=\"mbr-section-title col-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\" data-app-placeholder=\"Type Text\">\n                            <i> 03 </i>\n                        </h5>\n                        <p mbr-if=\"showColText\" class=\"mbr-text col-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text.col-text\" data-app-placeholder=\"Type Text\">\n                            Ipsum consequat nisl vel pretium lectus quam id\n                        </p>\n                    </div>\n                    <div mbr-if=\"colCount > 3\" class=\"col-12 col-sm-6 mb-2 mb-sm-4\">\n                        <h5 mbr-if=\"showColTitle\" class=\"mbr-section-title col-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\" data-app-placeholder=\"Type Text\">\n                            <i> 04 </i>\n                        </h5>\n                        <p mbr-if=\"showColText\" class=\"mbr-text col-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text.col-text\" data-app-placeholder=\"Type Text\">\n                            Nibh mauris cursus mattis molestie a iaculis\n                        </p>\n                    </div>\n                    <div mbr-if=\"colCount > 4\" class=\"col-12 col-sm-6 mb-2 mb-sm-4\">\n                        <h5 mbr-if=\"showColTitle\" class=\"mbr-section-title col-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\" data-app-placeholder=\"Type Text\">\n                            <i> 05 </i>\n                        </h5>\n                        <p mbr-if=\"showColText\" class=\"mbr-text col-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text.col-text\" data-app-placeholder=\"Type Text\">\n                            Dolor magna eget est lorem ipsum dolor sit\n                        </p>\n                    </div>\n                    <div mbr-if=\"colCount > 5\" class=\"col-12 col-sm-6 mb-2 mb-sm-4\">\n                        <h5 mbr-if=\"showColTitle\" class=\"mbr-section-title col-title mbr-fonts-style mb-1\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title.col-title\" data-app-placeholder=\"Type Text\">\n                            <i> 06 </i>\n                        </h5>\n                        <p mbr-if=\"showColText\" class=\"mbr-text col-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text.col-text\" data-app-placeholder=\"Type Text\">\n                            Mattis pellentesque id nibh tortor id aliquet\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 px-0 px-sm-3\">\n                <img src=\"@PROJECT_PATH@/assets/images/unnamed-4.webp\" alt=\"Pelican Reef\">\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uRZeQmaqHl",
          "_anchor": "list02-1",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "slider03",
          "_sourceTheme": "walletm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider03 mbr-embla walletm5\" group=\"Sliders &amp; Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"color\" title=\"Container BG\" value=\"#14161b\" name=\"containerBg\" selected=\"\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked=\"\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked=\"\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked=\"\">\n        <input type=\"color\" title=\"Arrows Color\" value=\"#02050a\" name=\"arrowsColor\" condition=\"arrows\">\n        <input type=\"color\" title=\"Arrows BG\" value=\"#e43f3f\" name=\"arrowsBg\" condition=\"arrows\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"30\" step=\"6\" value=\"6\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/walletm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#02050a\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f4f4f4\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"card-wrapper\">\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                            <b>A Visual Journey of Financial Planning</b>\n                        </h2>\n                    </div>\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport little-radius\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/514254712-24471073845830630-5001378745088270383-n.jpg-960x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/copilot-20250725-151418.png-960x640.png\" alt=\"Pelican Reef\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/copilot-20250725-151205.png-960x640.png\" alt=\"Pelican Reef\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-6.webp\" alt=\"Pelican Reef\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/lunch-frittierte-austern.jpg-765x433.jpg\" alt=\"Pelican Reef\" data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/the-pelican-reef-shrimp-salad-1.webp\" alt=\"Pelican Reef\" data-slide-to=\"5\" data-bs-slide-to=\"5\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/the-pelican-reef-flatbread-one.webp\" alt=\"Pelican Reef\" data-slide-to=\"6\" data-bs-slide-to=\"6\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-25.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"7\" data-bs-slide-to=\"7\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-24.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"8\" data-bs-slide-to=\"8\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-23.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"9\" data-bs-slide-to=\"9\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-22.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"10\" data-bs-slide-to=\"10\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/the-pelican-reef-the-pelican-reef-img-0303.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"11\" data-bs-slide-to=\"11\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/the-pelican-reef-img-3800.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"12\" data-bs-slide-to=\"12\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/img-1575.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"13\" data-bs-slide-to=\"13\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-21.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"14\" data-bs-slide-to=\"14\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-20.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"15\" data-bs-slide-to=\"15\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-19.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"16\" data-bs-slide-to=\"16\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-18.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"17\" data-bs-slide-to=\"17\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-17.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"18\" data-bs-slide-to=\"18\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-16.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"19\" data-bs-slide-to=\"19\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-15.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"20\" data-bs-slide-to=\"20\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-14.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"21\" data-bs-slide-to=\"21\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-13.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"22\" data-bs-slide-to=\"22\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-12.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"23\" data-bs-slide-to=\"23\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-11.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"24\" data-bs-slide-to=\"24\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/unnamed-10.jpg-640x640.jpg\" alt=\"Pelican Reef\" data-slide-to=\"25\" data-bs-slide-to=\"25\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img class=\"little-radius\" src=\"@PROJECT_PATH@/assets/images/copilot-20250728-120607.png-640x640.png\" alt=\"Pelican Reef\" data-slide-to=\"26\" data-bs-slide-to=\"26\">\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                \n                                \n                                \n                                \n                                \n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "position": "relative",
              "background-color": "@containerBg",
              "padding": "160px 48px",
              "margin": "6px 0",
              "@media (max-width: 1440px)": {
                "padding": "64px"
              },
              "@media (max-width: 992px)": {
                "padding": "48px 24px",
                "margin": "3px 0"
              },
              ".title-wrapper": {
                ".mbr-section-title": {
                  "display": "inline-block",
                  "width": "70%",
                  "margin-bottom": "84px",
                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "margin-bottom": "48px"
                  }
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "75%",
              "max-width": "75%",
              "&:nth-child(2n)": {
                "min-width": "40%",
                "max-width": "40%"
              },
              "&:nth-child(3n)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              "&:nth-child(4n)": {
                "min-width": "40%",
                "max-width": "40%"
              },
              "&:nth-child(5n)": {
                "min-width": "60%",
                "max-width": "60%"
              },
              "&:nth-child(6n)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              "@media (max-width: 767px)": {
                "min-width": "100% !important",
                "max-width": "100% !important"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  ".item-img": {
                    "img": {
                      "width": "100%",
                      "height": "880px",
                      "object-fit": "cover",
                      "@media (max-width: 1440px)": {
                        "height": "480px"
                      },
                      "@media (max-width: 992px)": {
                        "height": "300px"
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "45%",
              "width": "64px",
              "height": "64px",
              "font-size": "32px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "100%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "@media (max-width: 1540px)": {
                "bottom": "0"
              },
              "&:hover": {
                "opacity": ".8 !important"
              },
              "&:disabled": {
                "opacity": ".2 !important"
              },
              "&.embla__button--prev": {
                "left": "0",
                "@media (max-width: 1540px)": {
                  "left": "auto",
                  "margin-left": "-74px"
                }
              },
              "&.embla__button--next": {
                "right": "0",
                "@media (max-width: 1540px)": {
                  "right": "auto",
                  "margin-right": "-74px"
                }
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "display": "flex",
              "justify-content": "center",
              "& when (@arrows)": {
                "padding-left": "120px",
                "padding-right": "120px",
                "@media (max-width: 1540px)": {
                  "padding-bottom": "8rem",
                  "padding-left": "0",
                  "padding-right": "0"
                },
                "@media (max-width: 992px)": {
                  "padding-bottom": "6rem"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".mbr-section-title, .title-wrapper": {
              "color": "#f5f8ff",
              "text-align": "center"
            }
          },
          "_cid": "uSfKZZbHrX",
          "_anchor": "slider03-b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "padding": "80px 60px",
